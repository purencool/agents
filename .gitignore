# =====================================================================
# Ultra-Aggressive Global Rule (Ignore Everything, Whitelist Source)
# =====================================================================
/*

# =====================================================================
# Core Laravel Source Framework & Configuration
# =====================================================================
!/app/
!/bootstrap/
!/config/
!/resources/
!/routes/
!/tests/

# Core Root Files
!.gitignore
!artisan
!composer.json
!package.json
!vite.config.js
!tailwind.config.js
!postcss.config.js

# =====================================================================
# Strict Overrides for Folders Whitelisted Above
# =====================================================================
# Do not track any generated build manifests or local caches
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# Drop temporary databases
/database/*.sqlite
/database/*.sqlite-journal

# =====================================================================
# Completely Ignored (No exceptions, built by CLI tool)
# =====================================================================
/vendor/
/node_modules/
/public/build/
/public/hot/
/public/storage
composer.lock
package-lock.json
yarn.lock
.env*
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
