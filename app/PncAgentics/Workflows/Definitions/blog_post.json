{
  "name": "blog_post",
  "description": "Generates a full blog post using a multi-stage skill pipeline.",
  "stages": [
    {
      "id": "tone",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.research_preparation.tone_style_definer",
      "variables": {
        "title": "{{title}}",
        "description": "{{description}}",
        "context": "{{context}}",
        "type": "{{type}}",
        "lang": "{{lang}}"
      },
      "options": { "temperature": 0.3 },
      "output_key": "tone_style"
    },
    {
      "id": "outline",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.research_preparation.outline_generator",
      "variables": {
        "title": "{{title}}",
        "description": "{{description}}",
        "refinement_context": "\n\n## Tone & Style\n{{tone_style}}\n\n## Context\n{{context}}"
      },
      "options": { "temperature": 0.2 },
      "output_key": "outline"
    },
    {
      "id": "sections",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.orchestration.document_orchestrator",
      "variables": {
        "outline": "{{outline}}",
        "format_instruction": "Convert the outline sections into a plain JSON array of strings.",
        "refinement_context": "\n\n## Tone & Style\n{{tone_style}}\n\n## Context\n{{context}}"
      },
      "options": { "temperature": 0.1 },
      "output_key": "sections_json",
      "transform": "strip_code_fence"
    },
    {
      "id": "sections_loop",
      "type": "loop",
      "source": "{{sections_json}}",
      "item_key": "section",
      "stages": [
        {
          "id": "draft",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.batch_draft_engine",
          "variables": {
            "section": "{{section}}",
            "outline": "{{outline}}",
            "refinement_context": "\n\n## Tone & Style\n{{tone_style}}\n\n## Context\n{{context}}"
          },
          "options": { "temperature": 0.2 },
          "output_key": "core_draft"
        },
        {
          "id": "evidence",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.evidence_data_inserter",
          "variables": {
            "section": "{{section}}",
            "content": "{{core_draft}}",
            "refinement_context": "\n\n## Context\n{{context}}"
          },
          "options": { "temperature": 0.2 },
          "output_key": "evidenced_draft"
        },
        {
          "id": "insight",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.analogy_example_creator",
          "variables": {
            "section": "{{section}}",
            "content": "{{evidenced_draft}}",
            "refinement_context": "\n\n## Context\n{{context}}"
          },
          "options": { "temperature": 0.3 },
          "output_key": "insight_content"
        },
        {
          "id": "critique",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.counter_argument_builder",
          "variables": {
            "section": "{{section}}",
            "content": "{{insight_content}}",
            "refinement_context": "\n\n## Context\n{{context}}"
          },
          "options": { "temperature": 0.2 },
          "output_key": "critique_content"
        },
        {
          "id": "expand",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.batch_expand_engine",
          "variables": {
            "section": "{{section}}",
            "content": "{{critique_content}}",
            "refinement_context": "\n\n## Context\n{{context}}"
          },
          "options": { "temperature": 0.2 },
          "output_key": "value_content"
        },
        {
          "id": "polish",
          "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.body_content.internal_transition_smoother",
          "variables": {
            "content": "{{critique_content}}\n\n{{value_content}}",
            "refinement_context": "\n\n## Tone & Style\n{{tone_style}}"
          },
          "options": { "temperature": 0.2 },
          "output_key": "polished_section"
        }
      ],
      "accumulate": {
        "key": "body_canvas",
        "template": "\n\n## {{section}}\n\n{{polished_section}}"
      }
    },
    {
      "id": "introduction",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.hook_introduction_writer",
      "variables": {
        "title": "{{title}}",
        "description": "{{description}}",
        "body_context": "{{body_canvas}}",
        "refinement_context": "\n\n## Tone & Style\n{{tone_style}}\n\n## Context\n{{context}}"
      },
      "options": { "temperature": 0.4 },
      "output_key": "introduction"
    },
    {
      "id": "conclusion",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.core_writing.conclusion_writer",
      "variables": {
        "introduction": "{{introduction}}",
        "body": "{{body_canvas}}",
        "tone": "{{type}}",
        "refinement_context": "\n\n## Tone & Style\n{{tone_style}}\n\n## Context\n{{context}}"
      },
      "options": { "temperature": 0.3 },
      "output_key": "conclusion"
    },
    {
      "id": "proofread",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.review_refinement.copyeditor_grammarian",
      "variables": {
        "content": "# {{title}}\n\n{{introduction}}\n\n{{body_canvas}}\n\n## Conclusion\n\n{{conclusion}}",
        "lang": "{{lang}}"
      },
      "options": { "temperature": 0.1 },
      "output_key": "proofread_output"
    },
    {
      "id": "final_format",
      "skill": "sales_marketing.marketing.external_documentation.blog_posts.review_refinement.formatting_markdown_expert",
      "variables": {
        "content": "{{proofread_output}}",
        "refinement_context": "\n\n## Tone & Style\n{{tone_style}}"
      },
      "options": { "temperature": 0.1 },
      "output_key": "final_output"
    }
  ],
  "persist": {
    "path": "{{content_path_markdown}}"
  }
}
