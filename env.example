# ═══════════════════════════════════════════════════════════════
# SERVICES — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────
# AI / LLM
# ─────────────────────────────────────────────────────────────

# API key for the OpenAI-compatible LLM provider (chat + embeddings).
# Leave empty to use debug mode (AI_ENABLE=false) or a local proxy.
AI_API_KEY=""

# Base URL for the LLM API endpoint.
# Defaults to https://api.openai.com/v1 if empty.
AI_BASE_URL=""

# Chat model identifier (e.g. "gpt-4o", "claude-sonnet-4-20250514").
# Used by PncAgent::provider() for /chat/completions calls.
AI_MODEL=""

# Request timeout in seconds for LLM API calls.
# Applied to both chat completions and embedding requests.
AI_REQUEST_TIMEOUT=600

# Master switch for the AI service.
# "true"  → LLM calls are made normally.
# "false" → AgentService returns debug echo strings (no API calls).
#           Useful for testing prompt-building without incurring costs.
AI_ENABLE=true

# Token budget for chat history trimming.
# Set 5–10% below the model's actual context limit to avoid
# API rejections from token overruns.
AI_CONTEXT_WINDOW=50000

# ─────────────────────────────────────────────────────────────
# SMS
# ─────────────────────────────────────────────────────────────

# Twilio phone number in E.164 format (e.g. "+61412345678").
# Used as the "from" number for outbound SMS alerts.
SMS_FROM_NUMBER=

# Twilio Account SID (starts with "AC...").
SMS_SID=

# Twilio Auth Token (from Twilio Console → Account Info).
SMS_TOKEN=

# ─────────────────────────────────────────────────────────────
# REST API
# ─────────────────────────────────────────────────────────────

# Base URL for the external REST API (e.g. CMS, publishing platform).
REST_BASE_URL=

# API key/token for authenticating against the REST API.
REST_API_KEY=

# ─────────────────────────────────────────────────────────────
# EMAIL / ALERTS
# ─────────────────────────────────────────────────────────────

# Recipient for pipeline alert emails (errors, failures, etc.).
# Leave empty to disable email alerts.
ALERT_EMAIL=""

# ─────────────────────────────────────────────────────────────
# OVERLAY / INTEGRATION TEAM
# ─────────────────────────────────────────────────────────────
# These are host-mounted Docker volumes (env_file) where the
# integration team drops files to override baked-in defaults
# at runtime — no code changes or image rebuilds needed.

# Directory for custom/overridden workflow JSON files.
# Resolved relative to base_path(). Checked before the default
# definitions directory by WorkflowDefinitionLoader.
# Example: "../data/agents/custom/workflows"
OVERLAY_WORKFLOWS=""

# Directory for custom skill JSON overrides.
# Overridden skills replace the baked-in versions by key.
OVERLAY_OVERRIDES=""

# Directory for template overrides.
# Custom templates replace baked-in templates by filename.
TEMPLATE_OVERRIDES=""

# Directory for overlay templates (additional, non-replacing).
OVERLAY_TEMPLATES=""

# Directory for prepend content (prepended to skill system prompts).
OVERLAY_PREPENDS=""

# ─────────────────────────────────────────────────────────────
# CONCURRENCY
# ─────────────────────────────────────────────────────────────

# Concurrency driver for parallel track processing.
# "fork"  → spawns a separate PHP process per track (requires pcntl).
# "sync"  → runs tracks sequentially in the same process (fallback).
# Used by TemplateAgentContentAction via Concurrency::driver().
CONCURRENCY_DRIVER=fork

# ─────────────────────────────────────────────────────────────
# MCP (Model Context Protocol)
# ─────────────────────────────────────────────────────────────

# MCP server endpoint for tool-augmented agent calls.
# Leave empty if MCP is not in use.
MCP_SERVER=""
